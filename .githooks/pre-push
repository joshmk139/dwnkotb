#!/bin/sh
# Block any push that still contains Cursor attribution.
remote="$1"
url="$2"

z40="0000000000000000000000000000000000000000"
while read -r local_ref local_sha remote_ref remote_sha
do
  [ "$local_sha" = "$z40" ] && continue
  if [ "$remote_sha" = "$z40" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if git log --format='%B' "$range" 2>/dev/null | grep -Eiq 'Co-authored-by: Cursor|cursoragent@cursor\.com|Made-with: Cursor'; then
    echo "Push blocked: a commit still credits Cursor. Strip Co-authored-by / Made-with: Cursor and try again."
    exit 1
  fi
done
exit 0
